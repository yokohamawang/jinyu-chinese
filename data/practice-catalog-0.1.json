      "ja_meaning": "大丈夫です／気にしないで"
    },
    {
      "id": "daily-zaijian",
      "simplified": "再见",
      "pinyin": "zài jiàn",
      "ja_meaning": "さようなら"
    },
    {
      "id": "daily-extra-01-02",
      "simplified": "你好吗？",
      "pinyin": "nǐ hǎo ma",
      "ja_meaning": "お元気ですか？"
    },
    {
      "id": "daily-extra-01-03",
      "simplified": "初次见面。",
      "pinyin": "chū cì jiàn miàn",
      "ja_meaning": "初めまして。"
    },
    {
      "id": "daily-extra-01-04",
      "simplified": "请多关照。",
      "pinyin": "qǐng duō guān zhào",
      "ja_meaning": "よろしくお願いします。"
    },
    {
      "id": "daily-extra-01-05",
      "simplified": "明天见。",
      "pinyin": "míng tiān jiàn",
      "ja_meaning": "また明日会いましょう。"
    },
    {
      "id": "daily-extra-01-06",
      "simplified": "早上好。",
      "pinyin": "zǎo shang hǎo",
      "ja_meaning": "おはようございます。"
    },
    {
      "id": "daily-extra-01-07",
      "simplified": "晚上好。",
      "pinyin": "wǎn shang hǎo",
      "ja_meaning": "こんばんは。"
    },
    {
      "id": "daily-extra-01-08",
      "simplified": "晚安。",
      "pinyin": "wǎn ān",
      "ja_meaning": "おやすみなさい。"
    },
    {
      "id": "daily-extra-01-09",
      "simplified": "好久不见。",
      "pinyin": "hǎo jiǔ bú jiàn",
      "ja_meaning": "お久しぶりです。"
    },
    {
      "id": "daily-extra-02-01",
      "simplified": "我是日本人。",
      "pinyin": "wǒ shì Rì běn rén",
      "ja_meaning": "私は日本人です。"
    },
    {
      "id": "daily-extra-02-02",
      "simplified": "我叫桥本。",
      "pinyin": "wǒ jiào Qiáo běn",
      "ja_meaning": "私の名前は橋本です。"
    },
    {
      "id": "daily-extra-02-03",
      "simplified": "你叫什么名字？",
      "pinyin": "nǐ jiào shén me míng zi",
      "ja_meaning": "お名前は何ですか？"
    },
    {
      "id": "daily-extra-02-04",
      "simplified": "你几岁？",
      "pinyin": "nǐ jǐ suì",
      "ja_meaning": "何歳ですか？"
    },
    {
      "id": "daily-extra-02-05",
      "simplified": "我十岁。",
      "pinyin": "wǒ shí suì",
      "ja_meaning": "私は10歳です。"
    },
    {
      "id": "daily-extra-02-06",
      "simplified": "我住在日本。",
      "pinyin": "wǒ zhù zài rì běn",
      "ja_meaning": "私は日本に住んでいます。"
    },
    {
      "id": "daily-extra-02-07",
      "simplified": "很高兴认识你。",
      "pinyin": "hěn gāo xìng rèn shi nǐ",
      "ja_meaning": "知り合えてうれしいです。"
    },
    {
      "id": "daily-extra-03-01",
      "simplified": "谢谢你。",
      "pinyin": "xiè xie nǐ",
      "ja_meaning": "ありがとうございます。"
    },
    {
      "id": "daily-extra-03-05",
      "simplified": "请进。",
      "pinyin": "qǐng jìn",
      "ja_meaning": "どうぞお入りください。"
    },
    {
      "id": "daily-extra-03-06",
      "simplified": "请坐。",
      "pinyin": "qǐng zuò",
      "ja_meaning": "どうぞお座りください。"
    },
    {
      "id": "daily-extra-03-07",
      "simplified": "请等一下。",
      "pinyin": "qǐng děng yí xià",
      "ja_meaning": "少し待ってください。"
    },
    {
      "id": "daily-extra-03-08",
      "simplified": "没问题。",
      "pinyin": "méi wèn tí",
      "ja_meaning": "問題ありません。"
    },
    {
      "id": "daily-extra-04-01",
      "simplified": "这是什么？",
      "pinyin": "zhè shì shén me",
      "ja_meaning": "これは何ですか？"
    },
    {
      "id": "daily-extra-04-02",
      "simplified": "这是谁的？",
      "pinyin": "zhè shì shéi de",
      "ja_meaning": "これは誰のものですか？"
    },
    {
      "id": "daily-extra-04-03",
      "simplified": "你在哪里？",
      "pinyin": "nǐ zài nǎ lǐ",
      "ja_meaning": "どこにいますか？"
    },
    {
      "id": "daily-extra-04-04",
      "simplified": "现在几点？",
      "pinyin": "xiàn zài jǐ diǎn",
      "ja_meaning": "今何時ですか？"
    },
    {
      "id": "daily-extra-04-05",
      "simplified": "今天星期几？",
      "pinyin": "jīn tiān xīng qī jǐ",
      "ja_meaning": "今日は何曜日ですか？"
    },
    {
      "id": "daily-extra-05-01",
      "simplified": "这个多少钱？",
      "pinyin": "zhè ge duō shao qián",
      "ja_meaning": "これはいくらですか？"
    },
    {
      "id": "daily-extra-05-02",
      "simplified": "请给我这个。",
      "pinyin": "qǐng gěi wǒ zhè ge",
      "ja_meaning": "これをください。"
    },
    {
      "id": "daily-extra-05-03",
      "simplified": "太贵了。",
      "pinyin": "tài guì le",
      "ja_meaning": "高すぎます。"
    },
    {
      "id": "daily-extra-05-04",
      "simplified": "可以便宜一点吗？",
      "pinyin": "kě yǐ pián yi yì diǎn ma",
      "ja_meaning": "少し安くできますか？"
    },
    {
      "id": "daily-extra-05-05",
      "simplified": "我想看看这个。",
      "pinyin": "wǒ xiǎng kàn kan zhè ge",
      "ja_meaning": "これを見たいです。"
    },
    {
      "id": "daily-extra-05-06",
      "simplified": "可以用现金吗？",
      "pinyin": "kě yǐ yòng xiàn jīn ma",
      "ja_meaning": "現金は使えますか？"
    },
    {
      "id": "daily-extra-06-01",
      "simplified": "洗手间在哪里？",
      "pinyin": "xǐ shǒu jiān zài nǎ lǐ",
      "ja_meaning": "トイレはどこですか？"
    },
    {
      "id": "daily-extra-06-02",
      "simplified": "车站在哪里？",
      "pinyin": "chē zhàn zài nǎ lǐ",
      "ja_meaning": "駅はどこですか？"
    },
    {
      "id": "daily-extra-06-03",
      "simplified": "请问，地铁站在哪里？",
      "pinyin": "qǐng wèn dì tiě zhàn zài nǎ lǐ",
      "ja_meaning": "すみません、地下鉄の駅はどこですか？"
    },
    {
      "id": "daily-extra-06-04",
      "simplified": "我要去车站。",
      "pinyin": "wǒ yào qù chē zhàn",
      "ja_meaning": "駅に行きたいです。"
    },
    {
      "id": "daily-extra-06-05",
      "simplified": "在这里下车。",
      "pinyin": "zài zhè lǐ xià chē",
      "ja_meaning": "ここで降ります。"
    },
    {
      "id": "daily-extra-06-06",
      "simplified": "请往左走。",
      "pinyin": "qǐng wǎng zuǒ zǒu",
      "ja_meaning": "左へ行ってください。"
    },
    {
      "id": "daily-extra-06-07",
      "simplified": "请往右走。",
      "pinyin": "qǐng wǎng yòu zǒu",
      "ja_meaning": "右へ行ってください。"
    },
    {
      "id": "daily-extra-07-01",
      "simplified": "请给我一杯水。",
      "pinyin": "qǐng gěi wǒ yì bēi shuǐ",
      "ja_meaning": "水を一杯ください。"
    },
    {
      "id": "daily-extra-07-02",
      "simplified": "这个辣吗？",
      "pinyin": "zhè ge là ma",
      "ja_meaning": "これは辛いですか？"
    },
    {
      "id": "daily-extra-07-03",
      "simplified": "我饿了。",
      "pinyin": "wǒ è le",
      "ja_meaning": "おなかがすきました。"
    },
    {
      "id": "daily-extra-07-04",
      "simplified": "我渴了。",
      "pinyin": "wǒ kě le",
      "ja_meaning": "のどがかわきました。"
    },
    {
      "id": "daily-extra-07-05",
      "simplified": "请给我菜单。",
      "pinyin": "qǐng gěi wǒ cài dān",
      "ja_meaning": "メニューをください。"
    },
    {
      "id": "daily-extra-07-06",
      "simplified": "不要辣椒。",
      "pinyin": "bú yào là jiāo",
      "ja_meaning": "唐辛子を入れないでください。"
    },
    {
      "id": "daily-extra-07-07",
      "simplified": "很好吃。",
      "pinyin": "hěn hǎo chī",
      "ja_meaning": "とてもおいしいです。"
    },
    {
      "id": "daily-extra-07-08",
      "simplified": "请结账。",
      "pinyin": "qǐng jié zhàng",
      "ja_meaning": "お会計をお願いします。"
    },
    {
      "id": "daily-extra-08-01",
      "simplified": "我在学习中文。",
      "pinyin": "wǒ zài xué xí Zhōng wén",
      "ja_meaning": "中国語を勉強しています。"
    },
    {
      "id": "daily-extra-08-02",
      "simplified": "中文很难，但是很有意思。",
      "pinyin": "Zhōng wén hěn nán, dàn shì hěn yǒu yì si",
      "ja_meaning": "中国語は難しいですが、面白いです。"
    },
    {
      "id": "daily-extra-08-03",
      "simplified": "请再说一遍。",
      "pinyin": "qǐng zài shuō yí biàn",
      "ja_meaning": "もう一度言ってください。"
    },
    {
      "id": "daily-extra-08-04",
      "simplified": "请说慢一点。",
      "pinyin": "qǐng shuō màn yì diǎn",
      "ja_meaning": "もう少しゆっくり話してください。"
    },
    {
      "id": "daily-extra-08-05",
      "simplified": "我听不懂。",
      "pinyin": "wǒ tīng bù dǒng",
      "ja_meaning": "聞いてもわかりません。"
    },
    {
      "id": "daily-extra-08-06",
      "simplified": "这个字怎么读？",
      "pinyin": "zhè ge zì zěn me dú",
      "ja_meaning": "この字はどう読みますか？"
    },
    {
      "id": "daily-extra-08-07",
      "simplified": "我明白了。",
      "pinyin": "wǒ míng bai le",
      "ja_meaning": "わかりました。"
    },
    {
      "id": "daily-extra-09-01",
      "simplified": "一起玩吧！",
      "pinyin": "yì qǐ wán ba",
      "ja_meaning": "一緒に遊ぼう！"
    },
    {
      "id": "daily-extra-09-02",
      "simplified": "你喜欢什么？",
      "pinyin": "nǐ xǐ huan shén me",
      "ja_meaning": "何が好きですか？"
    },
    {
      "id": "daily-extra-09-03",
      "simplified": "我喜欢熊猫。",
      "pinyin": "wǒ xǐ huan xióng māo",
      "ja_meaning": "私はパンダが好きです。"
    },
    {
      "id": "daily-extra-09-04",
      "simplified": "轮到你了。",
      "pinyin": "lún dào nǐ le",
      "ja_meaning": "あなたの番です。"
    },
    {
      "id": "daily-extra-09-05",
      "simplified": "太好了！",
      "pinyin": "tài hǎo le",
      "ja_meaning": "やったね！"
    },
    {
      "id": "daily-extra-10-01",
      "simplified": "请帮帮我。",
      "pinyin": "qǐng bāng bang wǒ",
      "ja_meaning": "助けてください。"
    },
    {
      "id": "daily-extra-10-02",
      "simplified": "我不舒服。",
      "pinyin": "wǒ bù shū fu",
      "ja_meaning": "具合が悪いです。"
    },
    {
      "id": "daily-extra-10-03",
      "simplified": "我迷路了。",
      "pinyin": "wǒ mí lù le",
      "ja_meaning": "道に迷いました。"
    },
    {
      "id": "daily-extra-10-04",
      "simplified": "我想休息一下。",
      "pinyin": "wǒ xiǎng xiū xi yí xià",
      "ja_meaning": "少し休みたいです。"
    },
    {
      "id": "daily-extra-10-05",
      "simplified": "请给我打电话。",
      "pinyin": "qǐng gěi wǒ dǎ diàn huà",
      "ja_meaning": "電話してください。"
    }
  ],
